PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
DB_PATH=data.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Books seats under a "Simulated guests" account so shows look busy (demo only)
SIMULATE_DEMAND=true
# Opening hours (24h clock) and time zone used to validate showtimes
THEATRE_HOURS=12-24
# THEATRE_TZ=America/Toronto
# Portfolio demo: a regular customer login shown on the sign-in screen (never an admin)
DEMO_EMAIL=demo@nguyenawards.com
DEMO_PASSWORD=demo1234
# Hour (0-23, theatre time zone) when the demo account's bookings are wiped each day
DEMO_RESET_HOUR=4
